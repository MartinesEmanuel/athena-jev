# Required for real TypeSafe Jev System-1 judgments.
TYPESAFE_API_KEY=

# Optional. Set to 1 to emit local OpenCode cognitive runtime trace logs.
ATHENA_COGNITIVE_TRACE=

# Optional. Local Unix socket path for standalone HUD. Launcher sets this automatically.
ATHENA_HUD_SOCKET=

# Optional. Standalone OpenAI-compatible System-2 live probes only.
# Normal OpenCode integration uses OpenCode as System 2 and does not require these variables.
ATHENA_SYSTEM2_API_KEY=
ATHENA_SYSTEM2_MODEL=
ATHENA_SYSTEM2_BASE_URL=
ATHENA_SYSTEM2_TIMEOUT_MS=

# Optional compatibility names for standalone OpenAI-compatible System-2 probes.
OPENAI_API_KEY=
OPENAI_MODEL=
